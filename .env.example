# Quote Engine
QUOTE_DB_PATH=/app/data/quotes.db
QUOTE_PUBLIC_BASE_URL=http://localhost:8010/proposta
INTERNAL_BASE_URL=http://localhost:8010
QUOTE_ENGINE_HOST_PORT=8010

# Security HMAC (condiviso tra Next.js, n8n e Quote Engine)
QUOTE_ENGINE_HMAC_SECRET=

# DozenDev legal data - REQUIRED before real signature
DOZENDEV_LEGAL_DETAILS=DozenDev - [ragione sociale/nome, P.IVA, sede]
DOZENDEV_PEC=[PEC]
DOZENDEV_FORUM=Torino

# n8n event bus
N8N_EVENT_WEBHOOK_URL=http://n8n:5678/webhook/dozendev-events
# Optional event-specific hooks
N8N_QUOTE_SENT_WEBHOOK_URL=
N8N_QUOTE_APPROVED_WEBHOOK_URL=
N8N_PROPOSAL_INTERESTED_WEBHOOK_URL=http://n8n:5678/webhook/dozendev-proposal-interest
N8N_CALL_BOOKED_WEBHOOK_URL=
N8N_CALL_CANCELLED_WEBHOOK_URL=
N8N_CONTRACT_SENT_WEBHOOK_URL=
N8N_CONTRACT_SIGNED_WEBHOOK_URL=
N8N_DEPOSIT_PENDING_WEBHOOK_URL=
N8N_ONBOARDING_STARTED_WEBHOOK_URL=
N8N_PROJECT_READY_WEBHOOK_URL=

# n8n local container
N8N_HOST=localhost
N8N_PORT=5678
N8N_HOST_PORT=5679
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Rome
